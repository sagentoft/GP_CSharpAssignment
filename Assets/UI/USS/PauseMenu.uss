:root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

#pause-panel {
    width: 65%;
    max-width: 750px;
    padding: 48px;
    flex-direction: column;
    align-items: center;
    background-color: rgb(40, 45, 59);
    border-radius: 18px;
}

#pause-title {
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    margin-bottom: 40px;
}

#resume-button, #restart-button, #main-menu-button {
    width: 320px;
    height: 60px;
    flex-shrink: 0;
    margin: 6px;
    border-radius: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    background-color: rgb(54, 63, 84);
    border-width: 2px;
    border-color: rgb(75, 88, 115);
}

#resume-button {
    background-color: rgb(50, 137, 183);
    border-color: rgb(80, 190, 240);
}

#resume-button:hover, #restart-button:hover, #main-menu-button:hover {
    background-color: rgb(80, 190, 240);
    border-color: rgb(120, 220, 255);
}