:root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.004);
}

.level-up-panel {
    width: 85%;
    max-width: 1100px;
    padding-top: 32px;
    padding-right: 32px;
    padding-bottom: 32px;
    padding-left: 32px;
    background-color: rgb(25, 30, 43);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    align-items: center;
}

#choices-container {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    width: 100%;
}

.upgrade-card {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 240px;
    margin: 8px;
    padding: 20px;

    flex-direction: column;
    align-items: center;

    background-color: rgb(43, 51, 70);
    border-radius: 10px;

    border-width: 2px;
    border-color: rgb(75, 88, 115);
}

.upgrade-card:hover {
    background-color: rgb(58, 70, 96);
    border-color: rgb(80, 190, 240);
}

.upgrade-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 16px;
}

.upgrade-name {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    white-space: normal;
    margin-bottom: 12px;
}

.upgrade-description {
    font-size: 16px;
    -unity-text-align: middle-center;
    color: rgb(185, 195, 215);
    white-space: normal;
}

.upgrade-level {
    font-size: 14px;
    color: rgb(80, 190, 240);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}


