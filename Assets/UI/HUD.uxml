<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="xp-container" style="flex-grow: 1; position: absolute; width: 100%;">
        <ui:VisualElement name="xp-bar-background" style="flex-grow: 1; height: 12px; background-color: rgb(53, 53, 53);">
            <ui:VisualElement name="xp-bar-fill" style="flex-grow: 1; height: 12px; background-color: rgb(0, 160, 255);"/>
        </ui:VisualElement>
        <ui:Label text="Label" name="level-label" style="padding-top: 0; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 1px; font-size: 24px; padding-left: 12px;"/>
    </ui:VisualElement>
    <ui:Label text="Label" name="timer-label" style="position: absolute; top: 8px; right: 13px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 1px; font-size: 24px; padding-right: 16px;"/>
    <ui:Label text="Label" name="score-label" style="position: absolute; top: 8px; right: 50%; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 1px; font-size: 24px;"/>
</ui:UXML>
